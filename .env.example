# =============================================================
# MBK AI STUDIO OS - Environment Configuration Template
# Server environment variables for protected API routes.
# Configure these in your hosting dashboard (Vercel) or local .env.
# NEVER commit real secret values to git.
# =============================================================

# Supabase Server-Side Configuration (Privileged)
# Found under Project Settings -> API in your Supabase Dashboard
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Studio Admin Verification (Server-Side)
# The email address authorized to access /api/admin/* endpoints
ADMIN_EMAIL=your-admin-email@example.com

# AI Engine Configuration (Milestone 1+ Public Packaging Intelligence)
# Google Gemini API key from Google AI Studio (Server-side only)
GEMINI_API_KEY=your-gemini-api-key-placeholder
